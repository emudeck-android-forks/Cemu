++    echo "sdk.dir=$ANDROID_HOME" > "$ANDROID_DIR/local.properties"
++    bold "Created local.properties"
++fi
++
++# ─── Build ────────────────────────────────────────────────────────────────────
++bold "Building $BUILD_TYPE APK..."
++cd "$ANDROID_DIR"
++
++GRADLE_ARGS=("$GRADLE_TASK")
++if $CLEAN; then
++    GRADLE_ARGS=("clean" "${GRADLE_ARGS[@]}")
++fi
++
++./gradlew "${GRADLE_ARGS[@]}"
++
++# ─── Result ───────────────────────────────────────────────────────────────────
++echo
++if [[ -f "$APK_PATH" ]]; then
